#!/bin/sh /etc/rc.common
# GrKa OpenWRT - init-скрипт сервиса mihomo

START=99
STOP=15
USE_PROCD=1

CONF_DIR="/etc/mihomo"

start_service() {
	local PROG
	. /usr/libexec/grka/common.sh 2>/dev/null
	PROG="$(ensure_core 2>/dev/null)"
	if [ -z "$PROG" ]; then
		echo "Ядро mihomo не установлено — установите его через панель GrKa OpenWRT (LuCI -> Службы)"
		return 1
	fi
	if [ ! -f "$CONF_DIR/config.yaml" ]; then
		echo "Конфигурация $CONF_DIR/config.yaml не найдена"
		return 1
	fi

	procd_open_instance mihomo
	procd_set_param command "$PROG" -d "$CONF_DIR"
	procd_set_param file "$CONF_DIR/config.yaml"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn 3600 5 3
	procd_set_param limits core="unlimited" nofile="1000000 1000000"
	procd_close_instance
}

reload_service() {
	restart
}
